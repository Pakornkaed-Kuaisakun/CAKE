# ─── AI Providers ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
OLLAMA_BASE_URL=http://localhost:11434   # local Ollama instance

# Default provider: claude | openai | gemini | ollama
DEFAULT_PROVIDER=claude
DEFAULT_MODEL=claude-opus-4-5            # model name for the chosen provider

# ─── Discord ─────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_GUILD_ID=your_guild_id           # optional: restrict to one server

# ─── Email (IMAP) ────────────────────────────────────────────
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password             # use Gmail App Password

# ─── Google Calendar ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# ─── News ────────────────────────────────────────────────────
# Comma-separated RSS feed URLs
NEWS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml
